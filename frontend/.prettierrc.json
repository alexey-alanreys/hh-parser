{
  "$schema": "https://json.schemastore.org/prettierrc",

  "printWidth": 79,
  "tabWidth": 2,
  "useTabs": false,

  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,

  "trailingComma": "all",
  "arrowParens": "always",

  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true,

  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto"
}
